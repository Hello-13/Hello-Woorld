{
  "name": "study-widgets",
  "productName": "Study Widgets",
  "version": "1.0.0",
  "description": "Your claude.ai dashboard and Academic Hub as movable desktop widgets.",
  "main": "src/main.js",
  "private": true,
  "author": "Hello-13",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "smoke": "node test/smoke.js",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "io.github.hello13.studywidgets",
    "productName": "Study Widgets",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "identity": "-",
      "artifactName": "Study-Widgets-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Study-Widgets-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "artifactName": "Study-Widgets-${version}-linux-${arch}.${ext}"
    }
  }
}
