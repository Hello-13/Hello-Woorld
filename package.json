{
  "name": "string-theory",
  "private": true,
  "version": "1.0.0",
  "description": "A guitar practice studio in the browser: tuner, chords, scales, backing band, ear training and fretboard games.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:artifact": "npm run build && node scripts/build-artifact.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "preact": "^10.27.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "typescript": "~5.9.3",
    "vite": "7.3.7",
    "vitest": "^4.1.11"
  }
}
